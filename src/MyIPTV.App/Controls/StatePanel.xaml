<UserControl x:Class="MyIPTV.App.Controls.StatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MyIPTV.App.ViewModels"
             d:DesignHeight="320"
             d:DesignWidth="560"
             mc:Ignorable="d">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Loading content">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Value="{x:Static viewModels:ViewState.Loading}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ProgressBar
                Width="220"
                Height="4"
                IsIndeterminate="True" />
            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="Loading…" />
        </StackPanel>

        <StackPanel
            MaxWidth="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Empty content state">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Value="{x:Static viewModels:ViewState.Empty}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border
                Width="72"
                Height="72"
                HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceElevatedBrush}"
                CornerRadius="36">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="30"
                    Foreground="{DynamicResource AccentBrush}"
                    Text="{Binding Glyph, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Border>
            <TextBlock
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextSecondaryBrush}"
                LineHeight="22"
                Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            MaxWidth="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Content error state">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Value="{x:Static viewModels:ViewState.Error}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="42"
                Foreground="{DynamicResource ErrorBrush}"
                Text="&#xE783;" />
            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Unable to load content" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="Please try again. Technical details are recorded without exposing credentials."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
