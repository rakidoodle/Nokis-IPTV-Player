<Window x:Class="MyIPTV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="{Binding ApplicationName}"
        Width="960"
        Height="600"
        MinWidth="720"
        MinHeight="480"
        Background="#0F172A"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,0"
            Background="#111C32"
            BorderBrush="#24324A"
            BorderThickness="0,0,0,1">
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.Name="Application name"
                Foreground="#F8FAFC"
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Binding ApplicationName}" />
        </Border>

        <ContentControl
            Grid.Row="1"
            AutomationProperties.Name="Current page"
            Content="{Binding CurrentViewModel}" />

        <Border
            Grid.Row="2"
            Padding="16,0"
            Background="#111827"
            BorderBrush="#24324A"
            BorderThickness="0,1,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#94A3B8"
                FontSize="12"
                Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
