<Window x:Class="MyIPTV.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyIPTV.App.Converters"
        Title="{Binding ApplicationName}"
        Width="1180"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        Background="{DynamicResource AppBackgroundBrush}"
        KeyboardNavigation.TabNavigation="Continue"
        PreviewKeyDown="OnPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:ResponsiveSidebarWidthConverter x:Key="ResponsiveSidebarWidthConverter" />
        <converters:SidebarLabelVisibilityConverter x:Key="SidebarLabelVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource ResponsiveSidebarWidthConverter}}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="11">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentTextBrush}"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="M" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="{Binding ApplicationName}"
                        Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource SidebarLabelVisibilityConverter}}" />
                </Grid>

                <ListBox
                    Grid.Row="1"
                    Margin="0,8,0,12"
                    AutomationProperties.Name="Main navigation"
                    IsSynchronizedWithCurrentItem="True"
                    ItemContainerStyle="{StaticResource NavigationItemStyle}"
                    ItemsSource="{Binding NavigationItems}"
                    SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                    Style="{StaticResource NavigationListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="19"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    Text="{Binding Glyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    Text="{Binding Label}"
                                    Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource SidebarLabelVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Margin="22,0,22,20"
                    Foreground="{DynamicResource TextMutedBrush}"
                    FontSize="11"
                    Text="AUTHORIZED SOURCES ONLY"
                    Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource SidebarLabelVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="28,0"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Width="420"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <TextBox
                            x:Name="SearchBox"
                            AutomationProperties.HelpText="Press Control+F from anywhere in the application to search."
                            AutomationProperties.Name="Search media"
                            Style="{StaticResource SearchTextBoxStyle}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="14,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{DynamicResource TextMutedBrush}"
                            IsHitTestVisible="False"
                            Text="&#xE721;" />
                        <TextBlock
                            Margin="40,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextMutedBrush}"
                            IsHitTestVisible="False"
                            Text="Search your library">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Popup
                        x:Name="SearchPopup"
                        AllowsTransparency="True"
                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                        IsOpen="{Binding IsSearchOpen, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=SearchBox}"
                        PopupAnimation="Fade"
                        StaysOpen="False">
                        <Border
                            Width="420"
                            MaxHeight="360"
                            Margin="0,8,0,0"
                            Padding="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <ListBox
                                    AutomationProperties.Name="Search results"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding SearchResults}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Padding="12,9"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Title}"
                                                Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        FontSize="11"
                                                        Text="{Binding Subtitle}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="Searching…"
                                    Visibility="{Binding IsSearchBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <TextBlock
                                    Margin="12,18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="No matches found">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSearchResults}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSearchBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Popup>

                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="{Binding ThemeButtonLabel}"
                        Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{Binding ThemeButtonLabel}">
                        <TextBlock
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Text="{Binding ThemeGlyph}" />
                    </Button>
                </Grid>
            </Border>

            <ContentControl
                Grid.Row="1"
                AutomationProperties.Name="Current content page"
                Content="{Binding CurrentViewModel}"
                Focusable="False" />

            <Border
                Grid.Row="2"
                Padding="20,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SuccessBrush}"
                        CornerRadius="4" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="12"
                        Text="{Binding StatusMessage}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontSize="12"
                        Text="{Binding PlayerStatusMessage}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
