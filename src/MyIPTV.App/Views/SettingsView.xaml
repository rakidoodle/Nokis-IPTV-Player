<UserControl x:Class="MyIPTV.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock AutomationProperties.HeadingLevel="Level1" FontSize="30" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Text="{Binding Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel ItemWidth="400">
                <Border Margin="0,0,12,12" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="19" FontWeight="SemiBold" Text="General" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Start page" />
                        <ComboBox AutomationProperties.Name="Start page" ItemsSource="{Binding StartPages}" SelectedItem="{Binding StartPage}" Style="{StaticResource FormComboBoxStyle}" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Theme" />
                        <ComboBox AutomationProperties.Name="Theme" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Style="{StaticResource FormComboBoxStyle}" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Language" />
                        <ComboBox AutomationProperties.Name="Language" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Style="{StaticResource FormComboBoxStyle}" ToolTip="The interface is ready for future translated resources." />
                        <CheckBox Margin="0,14,0,0" AutomationProperties.Name="Remember last profile" Content="Remember last profile" IsChecked="{Binding RememberLastProfile}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,12,12" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="19" FontWeight="SemiBold" Text="Player" />
                        <TextBlock Margin="0,12,0,3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Default volume" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding DefaultVolume, StringFormat={}{0}%}" />
                            <Slider AutomationProperties.Name="Default volume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding DefaultVolume}" />
                        </DockPanel>
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Aspect ratio" />
                        <ComboBox AutomationProperties.Name="Default aspect ratio" ItemsSource="{Binding AspectRatios}" SelectedItem="{Binding AspectRatio}" Style="{StaticResource FormComboBoxStyle}" />
                        <CheckBox Margin="0,14,0,0" AutomationProperties.Name="Hardware decoding" Content="Use hardware decoding when supported" IsChecked="{Binding HardwareDecoding}" ToolTip="Applied to new player sessions." />
                        <CheckBox Margin="0,12,0,0" AutomationProperties.Name="Reconnect on failure" Content="Offer reconnect when playback fails" IsChecked="{Binding ReconnectOnFailure}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,12,12" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="19" FontWeight="SemiBold" Text="EPG" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="XMLTV source" />
                        <TextBox AutomationProperties.Name="EPG XMLTV source" Style="{StaticResource FormTextBoxStyle}" Text="{Binding EpgSource, UpdateSourceTrigger=PropertyChanged}" ToolTip="HTTPS URL or local XML/XML.GZ file." />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Refresh interval (hours)" />
                        <TextBox AutomationProperties.Name="EPG refresh hours" Style="{StaticResource FormTextBoxStyle}" Text="{Binding EpgRefreshHours}" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Display timezone" />
                        <ComboBox AutomationProperties.Name="EPG display timezone" ItemsSource="{Binding TimezoneBehaviors}" SelectedItem="{Binding EpgTimezoneBehavior}" Style="{StaticResource FormComboBoxStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,12,12" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="19" FontWeight="SemiBold" Text="Data" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Database location" />
                        <TextBlock Text="{Binding DatabaseLocation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabaseLocation}" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button AutomationProperties.Name="Clear disposable cache" Command="{Binding ClearCacheCommand}" Content="Clear cache" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0" AutomationProperties.Name="Clear watch history" Command="{Binding ClearWatchHistoryCommand}" Content="Clear watch history" Style="{StaticResource DangerButtonStyle}" />
                        </WrapPanel>
                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Open database folder" Command="{Binding OpenDatabaseFolderCommand}" Content="Open data folder" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,12,12" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="19" FontWeight="SemiBold" Text="About" />
                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="MyIPTV" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ApplicationVersion, StringFormat=Version {0}}" />
                        <TextBlock Margin="0,12,0,3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Logs location" />
                        <TextBlock Text="{Binding LogsLocation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogsLocation}" />
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Open-source notices are documented in docs/dependencies.md." TextWrapping="Wrap" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Content="Open logs folder" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,12,0">
            <Button DockPanel.Dock="Right" AutomationProperties.Name="Save settings" Command="{Binding SaveCommand}" Content="Save settings" Style="{StaticResource PrimaryButtonStyle}" />
            <ProgressBar DockPanel.Dock="Right" Width="80" Height="4" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
