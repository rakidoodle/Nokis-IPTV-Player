<UserControl x:Class="MyIPTV.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyIPTV.App.Behaviors"
             xmlns:converters="clr-namespace:MyIPTV.App.Converters"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:ProfileConnectionTypeToLabelConverter x:Key="ProfileConnectionTypeToLabelConverter" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                FontSize="30"
                FontWeight="SemiBold"
                Text="Profiles" />
            <TextBlock
                Margin="0,7,0,0"
                Foreground="{DynamicResource TextSecondaryBrush}"
                FontSize="15"
                Text="Manage legitimate IPTV services and local playlists."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Saved profiles" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Add profile"
                            Command="{Binding AddNewCommand}"
                            Content="Add"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <ListBox
                            AutomationProperties.Name="Saved IPTV profiles"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItemStyle}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="Margin" Value="0,2" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="12"
                                            Text="{Binding ConnectionType, Converter={StaticResource ProfileConnectionTypeToLabelConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProfiles}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="28"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="&#xE77B;" />
                            <TextBlock
                                Margin="0,10,0,0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="No profiles saved" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Text="Profile details" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Delete selected profile"
                            Command="{Binding DeleteCommand}"
                            Content="Delete"
                            Style="{StaticResource DangerButtonStyle}" />
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,18,0,16"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Profile name" />
                            <TextBox
                                Margin="0,7,0,14"
                                AutomationProperties.Name="Profile name"
                                MaxLength="100"
                                Style="{StaticResource FormTextBoxStyle}"
                                Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Connection type" />
                            <ComboBox
                                Margin="0,7,0,14"
                                AutomationProperties.Name="Connection type"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding ProfileTypes}"
                                SelectedItem="{Binding SelectedProfileType, Mode=TwoWay}"
                                Style="{StaticResource FormComboBoxStyle}" />

                            <TextBlock Text="Server / URL / local playlist" />
                            <Grid Margin="0,7,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.Name="Server URL or local playlist path"
                                    MaxLength="2048"
                                    Style="{StaticResource FormTextBoxStyle}"
                                    Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Browse for local playlist"
                                    Command="{Binding BrowsePlaylistCommand}"
                                    Content="Browse…"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Visibility="{Binding ShowsBrowseButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <StackPanel Visibility="{Binding ShowsCredentialFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Username" />
                                <TextBox
                                    Margin="0,7,0,14"
                                    AutomationProperties.Name="IPTV username"
                                    MaxLength="256"
                                    Style="{StaticResource FormTextBoxStyle}"
                                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Password" />
                                <PasswordBox
                                    Margin="0,7,0,7"
                                    AutomationProperties.Name="IPTV password"
                                    behaviors:PasswordBoxAssistant.BindPassword="True"
                                    behaviors:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="512"
                                    Style="{StaticResource FormPasswordBoxStyle}" />
                                <TextBlock
                                    Margin="0,0,0,14"
                                    Foreground="{DynamicResource WarningBrush}"
                                    FontSize="12"
                                    Text="Password is encrypted for your Windows account and is never stored in the database or logs."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <ProgressBar
                            Height="3"
                            Margin="0,0,0,10"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border
                            Padding="12,9"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            CornerRadius="7">
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                            <Button
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Cancel provider loading"
                                Command="{Binding ConnectCancelCommand}"
                                Content="Cancel Loading"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding TestConnectionCommand}"
                                Content="Test Connection"
                                Style="{StaticResource SecondaryButtonStyle}" />
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding SaveCommand}"
                                Content="Save"
                                Style="{StaticResource SecondaryButtonStyle}" />
                            <Button
                                Command="{Binding ConnectCommand}"
                                Content="Connect"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
