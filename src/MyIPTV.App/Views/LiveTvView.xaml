<UserControl x:Class="MyIPTV.App.Views.LiveTvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                FontSize="30"
                FontWeight="SemiBold"
                Text="{Binding Title}" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextSecondaryBrush}"
                FontSize="15"
                Text="{Binding Subtitle}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,20,0,0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <Grid MinWidth="840">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Categories" />
                        <ListBox
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Channel categories"
                            ItemsSource="{Binding Categories}"
                            ItemContainerStyle="{StaticResource NavigationItemStyle}"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            Style="{StaticResource NavigationListBoxStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="5" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Channels" />
                        <ListBox
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Live channels"
                            ItemsSource="{Binding FilteredChannels}"
                            ItemContainerStyle="{StaticResource NavigationItemStyle}"
                            SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            Style="{StaticResource NavigationListBoxStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="11"
                                            Text="{Binding Group}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button
                                AutomationProperties.Name="Play selected channel"
                                Command="{Binding PlaySelectedChannelCommand}"
                                Content="Play selected channel"
                                Style="{StaticResource PrimaryButtonStyle}" />
                            <Button
                                Margin="0,8,0,0"
                                AutomationProperties.Name="{Binding FavoriteButtonText}"
                                Command="{Binding ToggleFavoriteCommand}"
                                Content="{Binding FavoriteButtonText}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="2" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="#05070B"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <vlc:VideoView
                            x:Name="VideoSurface"
                            AutomationProperties.Name="Video player"
                            Background="Black"
                            MediaPlayer="{Binding Player.NativeMediaPlayer}">
                            <Grid
                                Background="Black"
                                Visibility="{Binding Player.ShowPlayerOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        FontSize="42"
                                        Text="&#xE714;" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        FontSize="16"
                                        Text="{Binding Player.StatusMessage}" />
                                </StackPanel>
                            </Grid>
                        </vlc:VideoView>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="44"
                                Height="44"
                                AutomationProperties.Name="Current channel logo"
                                Source="{Binding Player.LogoUrl}"
                                Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding Player.Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Text="NOW" />
                                <TextBlock Text="{Binding Player.CurrentProgram}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding EmptyTitle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Text="NEXT" />
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Player.NextProgram}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
            <Grid MinWidth="820">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    AutomationProperties.Name="{Binding Player.PlayPauseLabel}"
                    Command="{Binding Player.PlayPauseCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="{Binding Player.PlayPauseLabel}">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding Player.PlayPauseGlyph}" />
                </Button>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Stop playback"
                    Command="{Binding Player.StopCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Stop">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71A;" />
                </Button>
                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="{Binding Player.MuteLabel}"
                    Command="{Binding Player.ToggleMuteCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="{Binding Player.MuteLabel}">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding Player.MuteGlyph}" />
                </Button>
                <Slider
                    Grid.Column="3"
                    Margin="12,0"
                    AutomationProperties.Name="Volume"
                    Maximum="100"
                    Minimum="0"
                    TickFrequency="5"
                    Value="{Binding Player.Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="4"
                    AutomationProperties.Name="Reconnect stream"
                    Command="{Binding Player.ReconnectCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Reconnect">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" />
                </Button>
                <ComboBox
                    Grid.Column="5"
                    Margin="10,0,0,0"
                    AutomationProperties.Name="Aspect ratio"
                    ItemsSource="{Binding Player.AspectRatios}"
                    SelectedItem="{Binding Player.SelectedAspectRatio}"
                    Style="{StaticResource FormComboBoxStyle}"
                    ToolTip="Aspect ratio" />
                <ComboBox
                    Grid.Column="6"
                    Margin="10,0,0,0"
                    AutomationProperties.Name="Audio track"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Player.AudioTracks}"
                    SelectedItem="{Binding Player.SelectedAudioTrack}"
                    Style="{StaticResource FormComboBoxStyle}"
                    ToolTip="Audio track" />
                <ComboBox
                    Grid.Column="7"
                    Margin="10,0,0,0"
                    AutomationProperties.Name="Subtitle track"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Player.SubtitleTracks}"
                    SelectedItem="{Binding Player.SelectedSubtitleTrack}"
                    Style="{StaticResource FormComboBoxStyle}"
                    ToolTip="Subtitles" />
                <Button
                    Grid.Column="9"
                    AutomationProperties.Name="Toggle full screen"
                    Command="{Binding Player.ToggleFullScreenCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Full screen">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE740;" />
                </Button>
            </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
