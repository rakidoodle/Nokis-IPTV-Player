<UserControl x:Class="MyIPTV.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MyIPTV.App.Controls">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock AutomationProperties.HeadingLevel="Level1" FontSize="30" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Text="{Binding Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid x:Name="ContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox
                        AutomationProperties.Name="Catalog items"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource NavigationItemStyle}"
                        ScrollViewer.CanContentScroll="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        Style="{StaticResource NavigationListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" Text="&#xE734;">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding FavoriteButtonText}"
                            Command="{Binding ToggleFavoriteCommand}" Content="{Binding FavoriteButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
                <controls:StatePanel Glyph="{Binding EmptyGlyph}" Message="{Binding EmptyMessage}" State="{Binding State}" Title="{Binding EmptyTitle}">
                    <controls:StatePanel.Style>
                        <Style TargetType="controls:StatePanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:StatePanel.Style>
                </controls:StatePanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
