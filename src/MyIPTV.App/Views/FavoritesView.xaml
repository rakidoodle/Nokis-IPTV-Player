<UserControl x:Class="MyIPTV.App.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MyIPTV.App.Controls">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock AutomationProperties.HeadingLevel="Level1" FontSize="30" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Text="{Binding Subtitle}" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,24,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListBox AutomationProperties.Name="Favorite items" ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             Style="{StaticResource NavigationListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="6,4" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.PlayFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Play this favorite">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding KindLabel}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Left"
                            AutomationProperties.Name="Remove selected favorite"
                            Command="{Binding RemoveSelectedCommand}" Content="Remove favorite"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Grid.Style>
                        <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
                <controls:StatePanel Glyph="{Binding EmptyGlyph}" Message="{Binding EmptyMessage}" State="{Binding State}" Title="{Binding EmptyTitle}">
                    <controls:StatePanel.Style>
                        <Style TargetType="controls:StatePanel"><Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </controls:StatePanel.Style>
                </controls:StatePanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
