<UserControl x:Class="MyIPTV.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,30,32,28">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                FontSize="32"
                FontWeight="SemiBold"
                Text="{Binding Heading}" />
            <TextBlock
                MaxWidth="720"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource TextSecondaryBrush}"
                FontSize="16"
                LineHeight="24"
                Text="{Binding Description}"
                TextWrapping="Wrap" />

            <WrapPanel Margin="0,28,0,0">
                <Border
                    Width="220"
                    Margin="0,0,14,14"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="PROFILES" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="0" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="No source connected" />
                    </StackPanel>
                </Border>
                <Border
                    Width="220"
                    Margin="0,0,14,14"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="FAVORITES" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{Binding FavoriteCount}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="Build your collection" />
                    </StackPanel>
                </Border>
                <Border
                    Width="220"
                    Margin="0,0,14,14"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="RECENTLY WATCHED" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{Binding RecentCount}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{Binding RecentSummary}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border
                MaxWidth="760"
                Margin="0,4,0,0"
                HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecentItems}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Continue watching" />
                    <ListBox
                        Grid.Row="1"
                        MaxHeight="180"
                        Margin="0,10,0,0"
                        AutomationProperties.Name="Recently watched items"
                        ItemContainerStyle="{StaticResource NavigationItemStyle}"
                        ItemsSource="{Binding RecentItems}"
                        SelectedItem="{Binding SelectedRecentItem, Mode=TwoWay}"
                        Style="{StaticResource NavigationListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding KindLabel}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="18,0,4,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ProgressLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding RecentActionLabel}"
                            Command="{Binding PlayRecentCommand}" Content="{Binding RecentActionLabel}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <Border
                MaxWidth="760"
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="54"
                        Height="54"
                        Background="{DynamicResource SelectedBrush}"
                        CornerRadius="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="24"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="&#xE8B7;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,24,0">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Get started" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Add a local playlist or configure an authorized IPTV service."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Manage IPTV profiles"
                        Command="{Binding ManageProfilesCommand}"
                        Content="Add a profile"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
